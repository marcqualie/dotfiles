#!/usr/bin/env zsh

export PRINT_TRUSTED_DIR="false"

DOTFILES_DIR=$(cd "$(dirname $0)/.."; pwd)
cd $DOTFILES_DIR

source $DOTFILES_DIR/script/.shared
out "dotfiles/script/setup"

echo ""
[[ "$OSTYPE" == darwin* ]] && symlink_dotfile Brewfile
symlink_dotfile railsrc
symlink_dotfile gitconfig
symlink_dotfile gitignore-global
symlink_dotfile zshenv
symlink_dotfile zprofile
symlink_dotfile zshrc
symlink_dotfile zsh
symlink_dotfile rbenv/default-gems
symlink_dotfile gemrc
symlink_dotfile editorconfig
symlink_dotfile tigrc
symlink_dotfile gnupg/gpg.conf
symlink_dotfile gnupg/gpg-agent.conf
symlink_dotfile tmux.conf
symlink_dotfile tmux
symlink_dotfile npmrc

if [[ "$OSTYPE" == darwin* ]]; then
  # The playwright config points at a headed chrome-beta profile, which only
  # makes sense on a desktop Mac.
  symlink_dotfile playwright/cli.config.json

  echo ""
  symlink "$DOTFILES_DIR/vscode/settings.json" "$HOME/Library/Application Support/Code/User/settings.json"
  symlink "$DOTFILES_DIR/macos/quick-actions/copy-path" "$HOME/Library/Services/copy-path.workflow"
  symlink "$DOTFILES_DIR/ghostty/config" "$HOME/.config/ghostty/config"
  symlink "$DOTFILES_DIR/zed/settings.json" "$HOME/.config/zed/settings.json"
  symlink "$DOTFILES_DIR/zed/keymap.json" "$HOME/.config/zed/keymap.json"

  # vscode snippets cannot be symlinked
  echo ""
  mkdir -p "$HOME/Library/Application Support/Code/User/snippets"
  cp -r "$DOTFILES_DIR/vscode/snippets/" "$HOME/Library/Application Support/Code/User/snippets/"

  echo ""
  symlink ~/Library/Mobile\ Documents/com\~apple\~CloudDocs ~/iCloud\ Drive
else
  # Linux has no keychain, Homebrew gpg or GUI editor, so override the
  # macOS-specific parts of .gitconfig in the per-device file it includes.
  # Only written when missing, so local edits are kept.
  if [[ ! -f "$DOTFILES_DIR/.gitconfig.device" ]]; then
    echo ""
    out "Writing .gitconfig.device for Linux"
    cat > "$DOTFILES_DIR/.gitconfig.device" <<'GITCONFIG'
# Generated by script/bootstrap on Linux. Safe to edit; it is not regenerated.

[gpg]
	program = gpg

# No signing key on this device. Set signingKey and flip this back to enable.
[commit]
	gpgSign = false

# An empty helper clears osxkeychain from the shared .gitconfig.
[credential]
	helper =

[core]
	editor = nano
GITCONFIG
  fi
fi

# Syncthing global ignores
echo ""
out "Configuring Syncthing"
[[ ! -d "~/src/marcqualie" ]] && mkdir -p ~/src/marcqualie
for ORG_PATH in ~/src/*; do
  cp "$DOTFILES_DIR/.stignore" "$ORG_PATH/.stignore-default"
  if [ ! -f  "$ORG_PATH/.stignore" ]; then
    echo "  Including default .stignore in $ORG_PATH"
    echo "#include .stignore-default" > "$ORG_PATH/.stignore"
  fi
done
[[ -d ~/Sync ]] && cp "$DOTFILES_DIR/.stignore" ~/Sync/.stignore
[[ -d ~/Downloads ]] && cp "$DOTFILES_DIR/.stignore" ~/Downloads/.stignore

# Permissions
chmod -R 700 ~/.gnupg

# Apply macOS defaults last so the "log out to apply" notice is shown at the end.
# defaults.sh does its own logging, so run it directly rather than via `run`
# (which would re-indent its output).
if [[ "$OSTYPE" == darwin* ]]; then
  echo ""
  out "macos/defaults"
  zsh "$DOTFILES_DIR/macos/defaults.sh"
fi

# Line break before system is reinitialised
echo ""
