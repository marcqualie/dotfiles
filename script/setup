#!/usr/bin/env zsh

if [[ "$OSTYPE" == darwin* ]]; then
  # warn if brew is not available
  if ! command -v brew &> /dev/null; then
    echo "Homebrew is not installed. Install via https://brew.sh"
    exit 1
  fi

  brew install git
  brew install zsh
else
  # Linux: git and zsh come from the system package manager.
  for cmd in git zsh; do
    if ! command -v $cmd &> /dev/null; then
      echo "$cmd is not installed. Install it with your package manager (e.g. apt install $cmd)"
      exit 1
    fi
  done
fi

script/bootstrap
