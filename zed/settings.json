// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
{
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "terminal": {
    "dock": "bottom",
    // Attach each terminal to a per-project tmux session, sharing the "ide-"
    // session namespace with vscode's "tmux-project" profile so both editors
    // land in the same session. The name is derived from $PWD, so the
    // working_directory below is what links a terminal to its project.
    "working_directory": "current_project_directory",
    "shell": {
      "with_arguments": {
        "program": "/bin/zsh",
        "args": [
          "-c",
          "exec /opt/homebrew/bin/tmux new-session -A -s \"$(~/.dotfiles/bin/tmux-session-name)\""
        ]
      }
    },
    // Zed would otherwise type an activate command into the attached tmux
    // session on startup.
    "detect_venv": "off",
    "font_family": "JetBrainsMono NF",
    "font_fallbacks": ["Cascadia Mono NF", "Menlo"],
    "font_features": {
      "calt": false
    },
    "max_scroll_history_lines": 100000
  },
  "project_panel": {
    "dock": "right"
  },
  "bottom_dock_layout": "full",
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
      "default_model": "opus"
    }
  },
  "agent": {
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono NF",
  "buffer_font_fallbacks": ["Cascadia Mono NF", "Menlo"],
  "buffer_font_features": {
    "calt": false
  },
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
}
