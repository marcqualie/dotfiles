#!/usr/bin/env sh
#
# tmux-session-name — derive a stable, tmux-safe session name for a directory,
# used by editor integrated-terminal profiles (VS Code "tmux-project", Zed
# terminal.shell) so each project window attaches to its own session.
#
#   git repo (github)   ->  ide-owner/repo
#   git repo (other)    ->  ide-repo
#   linked worktree     ->  ide-owner/repo/<worktree>   (grouped, distinct)
#   not a git repo      ->  ide-<~/full/path>
#
# The prefix is editor-agnostic ("ide-") on purpose: opening a project in both
# VS Code and Zed attaches both to the same session, so the two stay in sync.
# tmux's default `window-size latest` means the window follows whichever client
# was used most recently, so sharing doesn't pin it to the smaller viewport.
# Override with TMUX_SESSION_PREFIX to carve out a separate namespace.
#
# tmux forbids '.' and ':' in session names: a '.' makes `new-session` fail
# outright (which is why ~/.dotfiles — session "ide-marc/.dotfiles" — could
# never launch a terminal). '/' is legal and kept so windows nest under a repo
# label; every other reserved character is folded to '-'.
#
# Repo identity comes from the primary worktree's origin, so a linked worktree
# under <repo>/.worktrees/<branch> resolves to owner/repo instead of the useless
# "<.worktrees>/<branch>" the old inline ${PWD} expansion produced.

set -u

dir="${1:-$PWD}"

# tmux session names can't contain '.' or ':'; fold both to '-' and squeeze runs.
sanitize() {
  printf '%s' "$1" | tr '.:' '--' | tr -s '-'
}

# Reuse the exact repo/path detection the zsh prompt and tmux status bar use,
# so the session name matches how the directory is labelled everywhere else.
. "$HOME/.dotfiles/.zsh/repo-context.sh"
repo_context "$dir"

if [ -n "$RC_KIND" ] && [ "$RC_KIND" != "folder" ]; then
  name="$RC_LABEL"
  # Linked worktrees keep their git dir under <repo>/.git/worktrees/<name>;
  # append that name so each worktree gets a distinct session grouped under the
  # primary repo label.
  case "$(git -C "$dir" rev-parse --git-dir 2>/dev/null)" in
    */worktrees/*)
      name="$name/$(basename "$(git -C "$dir" rev-parse --git-dir 2>/dev/null)")"
      ;;
  esac
else
  # Not a git repo: fall back to the full path with $HOME rendered as '~'.
  case "$dir" in
    "$HOME") name="~" ;;
    "$HOME"/*) name="~/${dir#"$HOME"/}" ;;
    *) name="$dir" ;;
  esac
fi

printf '%s%s\n' "${TMUX_SESSION_PREFIX-ide-}" "$(sanitize "$name")"
